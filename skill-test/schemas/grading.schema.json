{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "grading.json reporting contract",
  "type": "object",
  "required": ["expectations"],
  "properties": {
    "expectations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "passed", "evidence"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
