{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "eval_metadata.json contract",
  "type": "object",
  "required": ["eval_id", "eval_name", "prompt", "assertions"],
  "properties": {
    "eval_id": {
      "type": "integer"
    },
    "eval_name": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
