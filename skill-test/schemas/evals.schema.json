{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "evals/evals.json contract",
  "type": "object",
  "required": ["skill_name", "evals"],
  "properties": {
    "skill_name": {
      "type": "string",
      "minLength": 1
    },
    "evals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "prompt", "expected_output"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "expected_output": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
