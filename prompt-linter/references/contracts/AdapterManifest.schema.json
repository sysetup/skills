{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prompt-toolkit:AdapterManifest:2.0.0",
  "title": "AdapterManifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "2.0.0"
      ]
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "support_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "last_verified": {
            "type": "string",
            "format": "date"
          },
          "product_version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "official",
              "project"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "contradictory"
            ]
          },
          "representation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "url",
          "title",
          "last_verified",
          "product_version",
          "kind",
          "status"
        ]
      },
      "minItems": 1
    },
    "freshness_days": {
      "type": "integer",
      "minimum": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "representations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "persistent",
                "reusable_action",
                "agent",
                "task",
                "delegation",
                "api",
                "runtime_policy"
              ]
            },
            "minItems": 1
          },
          "activation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "scope_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "authority_intents": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "serializer": {
            "type": "string",
            "enum": [
              "markdown",
              "frontmatter",
              "toml-command",
              "api-fragment",
              "generic-api",
              "runtime-contract"
            ]
          },
          "path_template": {
            "type": "string",
            "minLength": 1
          },
          "metadata_schema": {
            "type": "object"
          },
          "metadata_values": {
            "type": "object",
            "additionalProperties": true
          },
          "metadata_fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "companion_files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "yaml",
                    "json"
                  ]
                },
                "values": {
                  "type": "object"
                },
                "manual_values": {
                  "type": "object"
                }
              },
              "required": [
                "path",
                "format",
                "values",
                "manual_values"
              ]
            },
            "minItems": 0
          },
          "activation_semantics": {
            "type": "string",
            "minLength": 1
          },
          "scope_semantics": {
            "type": "string",
            "minLength": 1
          },
          "authority_semantics": {
            "type": "string",
            "minLength": 1
          },
          "variables": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "request",
                  "named",
                  "aggregate"
                ]
              },
              "token": {
                "type": "string"
              }
            },
            "required": [
              "mode",
              "token"
            ]
          },
          "resources": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "native",
                "instruction-only",
                "unsupported"
              ]
            }
          },
          "unsupported_features": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "validation_rules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "migration_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "forbidden_sequences": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "max_characters": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "id",
          "surfaces",
          "activation",
          "scope_kinds",
          "authority_intents",
          "serializer",
          "path_template",
          "metadata_schema",
          "metadata_values",
          "metadata_fields",
          "companion_files",
          "activation_semantics",
          "scope_semantics",
          "authority_semantics",
          "variables",
          "resources",
          "capabilities",
          "unsupported_features",
          "validation_rules",
          "migration_notes",
          "forbidden_sequences",
          "max_characters"
        ]
      },
      "minItems": 1
    },
    "unsupported_surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "persistent",
          "reusable_action",
          "agent",
          "task",
          "delegation",
          "api",
          "runtime_policy"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "id",
    "product",
    "support_scope",
    "provenance",
    "freshness_days",
    "warnings",
    "representations",
    "unsupported_surfaces"
  ]
}
