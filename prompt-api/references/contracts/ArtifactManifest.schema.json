{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prompt-toolkit:ArtifactManifest:1.0.0",
  "title": "ArtifactManifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "target_harness": {
      "type": "string",
      "minLength": 1
    },
    "representation": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      },
      "minItems": 1
    },
    "instruction_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapter_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapter_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "last_verified": {
            "type": "string",
            "format": "date"
          },
          "product_version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "official",
              "project"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "contradictory"
            ]
          }
        },
        "required": [
          "url",
          "title",
          "last_verified",
          "product_version",
          "kind",
          "status"
        ]
      },
      "minItems": 1
    },
    "portability_status": {
      "type": "string",
      "enum": [
        "supported",
        "supported-with-warning",
        "lossy",
        "unsupported"
      ]
    },
    "losses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "enforcement": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "target_harness",
    "representation",
    "files",
    "instruction_spec_sha256",
    "adapter_sha256",
    "adapter_sources",
    "portability_status",
    "losses",
    "warnings",
    "enforcement"
  ]
}
