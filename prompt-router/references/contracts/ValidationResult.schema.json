{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prompt-toolkit:ValidationResult:2.0.0",
  "title": "ValidationResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "2.0.0"
      ]
    },
    "artifact_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not-run",
        "inconclusive"
      ]
    },
    "portability_status": {
      "type": "string",
      "enum": [
        "supported",
        "supported-with-warning",
        "lossy",
        "unsupported"
      ]
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "layer": {
            "type": "string",
            "enum": [
              "schema",
              "semantic",
              "native",
              "quality",
              "authority_safety",
              "portability",
              "behavioral"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not-run",
              "inconclusive"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "layer",
          "status",
          "evidence"
        ]
      },
      "minItems": 7,
      "maxItems": 7,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "layer": {
                "const": "schema"
              }
            },
            "required": [
              "layer"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "layer": {
                "const": "semantic"
              }
            },
            "required": [
              "layer"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "layer": {
                "const": "native"
              }
            },
            "required": [
              "layer"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "layer": {
                "const": "quality"
              }
            },
            "required": [
              "layer"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "layer": {
                "const": "authority_safety"
              }
            },
            "required": [
              "layer"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "layer": {
                "const": "portability"
              }
            },
            "required": [
              "layer"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "layer": {
                "const": "behavioral"
              }
            },
            "required": [
              "layer"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "enum": [
              "schema",
              "semantic",
              "native",
              "quality",
              "authority_safety",
              "portability",
              "behavioral"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "layer",
          "severity",
          "path",
          "message",
          "capability"
        ]
      },
      "minItems": 0
    },
    "behavioral_claim": {
      "const": "Static checks do not establish model obedience or task effectiveness."
    },
    "native_checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not-run",
                "inconclusive"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "status",
            "evidence"
          ]
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not-run",
                "inconclusive"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "status",
            "evidence"
          ]
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not-run",
                "inconclusive"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "status",
            "evidence"
          ]
        }
      },
      "required": [
        "metadata",
        "projection",
        "execution"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "status",
    "portability_status",
    "layers",
    "findings",
    "behavioral_claim"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.0.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "native_checks"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.0.0"
          },
          "layers": {
            "contains": {
              "properties": {
                "layer": {
                  "const": "native"
                },
                "status": {
                  "const": "passed"
                }
              },
              "required": [
                "layer",
                "status"
              ]
            }
          }
        },
        "required": [
          "schema_version",
          "layers"
        ]
      },
      "then": {
        "properties": {
          "native_checks": {
            "properties": {
              "execution": {
                "properties": {
                  "status": {
                    "const": "passed"
                  },
                  "evidence": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "behavioralEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "inconclusive",
            "not-run"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "version"
                ]
              },
              "harness": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "version"
                ]
              },
              "configuration": {
                "type": "object"
              },
              "evidence_location": {
                "type": "string",
                "minLength": 1
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "input": {
                      "type": "string",
                      "minLength": 1
                    },
                    "input_reference": {
                      "type": "string",
                      "minLength": 1
                    },
                    "observed_output": {
                      "type": "string",
                      "minLength": 1
                    },
                    "output_reference": {
                      "type": "string",
                      "minLength": 1
                    },
                    "rubric": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "result": {
                      "enum": [
                        "passed",
                        "failed",
                        "inconclusive"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "rubric",
                    "result"
                  ],
                  "allOf": [
                    {
                      "anyOf": [
                        {
                          "required": [
                            "input"
                          ]
                        },
                        {
                          "required": [
                            "input_reference"
                          ]
                        }
                      ]
                    },
                    {
                      "anyOf": [
                        {
                          "required": [
                            "observed_output"
                          ]
                        },
                        {
                          "required": [
                            "output_reference"
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "run_id",
              "model",
              "harness",
              "cases"
            ]
          }
        }
      },
      "required": [
        "status",
        "evidence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "inconclusive"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not-run"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
