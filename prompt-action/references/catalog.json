{
  "generator_surfaces": {
    "agent": "prompt-agent",
    "api": "prompt-api",
    "delegation": "prompt-delegation",
    "persistent": "prompt-persistent",
    "reusable_action": "prompt-action",
    "task": "prompt-task"
  },
  "operation_aliases": {
    "optimize": "enhance",
    "refactor": "enhance"
  },
  "operations": [
    "create",
    "consolidate",
    "enhance",
    "audit",
    "convert",
    "migrate",
    "refactor",
    "optimize"
  ],
  "result_contract_versions": {
    "RouteDecision": "2.1.0",
    "ValidationResult": "2.0.0"
  },
  "role_commands": {
    "generator": [
      "scaffold",
      "render",
      "migrate",
      "validate",
      "check-contract"
    ],
    "linter": [
      "validate",
      "check-contract"
    ],
    "router": [
      "route",
      "check-contract"
    ],
    "transformer": [],
    "utility": []
  },
  "routing_patterns": {
    "agent": "agent definition|define an agent|custom agent|privileged instruction|system/developer instruction layer",
    "api": "api (?:prompt|template|instruction|message)|programmatic prompt|request[- ]time instruction|message/role binding|structured[- ]output prompt",
    "delegation": "delegat(?:e|ion)|subagent (?:task|contract)|worker return contract",
    "persistent": "agents\\.md|claude\\.md|gemini\\.md|persistent instructions?|repository instructions?|workspace instructions?|always[- ]on instructions?",
    "reusable_action": "reusable (?:action|workflow|prompt)|skill\\.md|slash command|custom command|model[- .]?selectable capability",
    "runtime_policy": "before (?:the )?(?:llm|model)|pre[- ]llm|pre[- ]model|intercept.*(?:send|model)",
    "task": "one[- ]shot prompt|session prompt|task prompt|paste[- ]ready (?:request|prompt)|execution brief"
  },
  "schema_version": "1.0.0",
  "skills": {
    "prompt-action": "reusable_action",
    "prompt-agent": "agent",
    "prompt-api": "api",
    "prompt-delegation": "delegation",
    "prompt-dictamen": null,
    "prompt-enhance": null,
    "prompt-handoff": null,
    "prompt-linter": null,
    "prompt-persistent": "persistent",
    "prompt-router": null,
    "prompt-task": "task"
  },
  "surfaces": [
    "persistent",
    "reusable_action",
    "agent",
    "task",
    "delegation",
    "api",
    "runtime_policy"
  ],
  "transformers": {
    "prompt-enhance": {
      "capability": "prompt-enhancement.v1",
      "cross_surface": true,
      "operations": [
        "enhance"
      ]
    }
  },
  "utilities": {
    "prompt-dictamen": {
      "capability": "dictamen-execution-prompt.v1",
      "patterns": [
        "\\b(?:prepare|compile|convert|transform|turn|generate|create)\\b.{0,80}\\b(?:settled|operative|approved|final|latest)\\b.{0,40}\\b(?:technical\\s+)?dictamen\\b(?:.{0,80}\\b(?:execution|implementation)\\s+prompt\\b)?",
        "\\b(?:prepare|compile|convert|transform|turn|generate|create)\\b.{0,80}\\b(?:technical\\s+)?dictamen\\b.{0,80}\\b(?:into|as)\\b.{0,40}\\b(?:execution|implementation)\\s+prompt\\b"
      ]
    },
    "prompt-handoff": {
      "capability": "conversation-handoff.v1",
      "patterns": [
        "\\b(?:compact|summari[sz]e|package|prepare|create)\\b.{0,80}\\b(?:this|current|the)?\\s*(?:conversation|session|chat)\\b.{0,80}\\b(?:hand[- ]?off|handover|continuation)\\b",
        "\\b(?:conversation|session|chat)\\b.{0,80}\\b(?:hand[- ]?off|handover)\\b.{0,80}\\b(?:fresh|new|next|continu(?:e|ation))\\b",
        "\\b(?:prepare|create|compact)\\b.{0,40}\\bhand[- ]?off\\b.{0,40}\\b(?:fresh|new|next)\\s+session\\b"
      ]
    }
  },
  "operation_surface_constraints": {
    "consolidate": [
      "persistent"
    ]
  },
  "legacy_surface_mappings": {
    "agents-md": "persistent",
    "vendor-always-on": "persistent",
    "tui-command": "reusable_action",
    "system-prompt": "agent",
    "session-inject": "task",
    "api-template": "api",
    "delegated-task": "delegation",
    "pre-llm-hook": "runtime_policy"
  }
}
