{
  "title": "Logical question set",
  "type": "object",
  "required": ["questions"],
  "additionalProperties": false,
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "kind", "required", "options", "default"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "header": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "kind": {
            "type": "string",
            "enum": ["single-select", "multi-select", "confirm", "free-text"]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "description"],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "preview": {
                  "type": ["string", "null"],
                  "maxLength": 4000
                }
              }
            }
          },
          "default": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "rationale": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
